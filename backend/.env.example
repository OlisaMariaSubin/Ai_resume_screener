# Database
DATABASE_URL=sqlite:///./resume_screening.db

# Matching method: tfidf | hybrid
MATCHING_METHOD=tfidf

# Hybrid weights (only used when MATCHING_METHOD=hybrid) - must sum sensibly, they are
# renormalized internally if they don't sum to 1.0
TFIDF_WEIGHT=0.4
EMBEDDING_WEIGHT=0.4
SKILL_WEIGHT=0.2

# Default overall-score component weights (percent, must sum to 100)
DEFAULT_SKILL_MATCH_WEIGHT=50
DEFAULT_TEXT_SIMILARITY_WEIGHT=30
DEFAULT_EXPERIENCE_WEIGHT=10
DEFAULT_EDUCATION_WEIGHT=10

# Upload limits
MAX_UPLOAD_SIZE_MB=10

# Optional: LLM-generated match explanations (Section 9.2). Leave blank to disable the
# feature cleanly - the /explain endpoint will report "explanations unavailable".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# CORS
FRONTEND_ORIGIN=http://localhost:5173
